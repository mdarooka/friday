PORT=4871
HOST=127.0.0.1
# The one public origin. Required when NODE_ENV=production (the server refuses to start without it).
# Production is https://fridaytravel.vercel.app. Do not set a Vercel preview host or
# friday-travel-peach.vercel.app: those hosts redirect to the public origin. In development an
# Origin that matches the Host header (127.0.0.1, a LAN address, a dev proxy) is accepted too.
APP_ORIGIN=http://localhost:4871
# Local Docker deployment uses Caddy's internal localhost certificate. Replace with a DNS name for public launch.
APP_DOMAIN=localhost
# NODE_ENV=production
# Set to 1 only behind a reverse proxy: rate limits then key on the right-most X-Forwarded-For hop.
TRUST_PROXY=
# PostgreSQL. Leave all of these empty to use PGlite (an in-process Postgres) under .data/pglite for local development.
# NODE_ENV=production refuses to start without them. Set DATABASE_URL, or the five DATABASE_* values below it.
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# Search indexing is hidden by default. Set to on only when public pages should be indexed.
SEARCH_INDEXING=off
# Friday uses the Claude API (Anthropic) for all AI features: research chat, reel import and itinerary generation.
# Research and reel import stay off until ANTHROPIC_API_KEY is set (server-side only, never exposed to the browser).
ANTHROPIC_API_KEY=
AI_PROVIDER=claude
AI_MODEL=claude-sonnet-5-5
# Optional stronger model for Deep research and source verification.
AI_DEEP_MODEL=
# Optional output effort: low, medium, high, xhigh or max.
AI_EFFORT=
# Optional read-only Google Gmail and Calendar integration. See docs/google-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate 32 random bytes and store as 64 hexadecimal characters.
GOOGLE_TOKEN_KEY=
# Optional Google Places API (New) key for sourced addresses, hours, ratings, reviews and photos.
GOOGLE_PLACES_API_KEY=

# --- Villa discovery and team-managed inventory ---
# Comma-separated Friday account email allowlist for villa inventory and owner-submission inbox access.
# Leave empty until the owner identifies the admin account; no account is granted access by default.
VILLA_ADMIN_EMAILS=
# Friday human quote queue and outbound quote email.
# Add only team accounts authorized to review requests. Leave empty to disable quote administration.
QUOTE_ADMIN_EMAILS=
# Add only team accounts authorized to review AI and trip-chat conversations. Leave empty to disable review access.
AI_REVIEW_ADMIN_EMAILS=
# Hexclave notification destination for new public commission/newsletter enquiries.
# Set this in the server environment after the owner chooses the receiving inbox.
FRIDAY_ENQUIRY_EMAIL=
# Scheduled jobs (modes: off | dry-run | live; empty = dry-run). Live runs need Hexclave email and three completed dry-run days,
# otherwise they are held back as dry-runs. Each job runs at most once per day (weekly for the guide digest).
# Automatic T-7 trip briefings to travellers:
FRIDAY_BRIEFING_AUTOSEND=
# Daily open-quote queue digest to one designer (QUOTE_DIGEST_EMAIL, else the first QUOTE_ADMIN_EMAILS entry, else FRIDAY_ENQUIRY_EMAIL):
FRIDAY_QUOTE_DIGEST=
QUOTE_DIGEST_EMAIL=
# Weekly "Was this guide useful?" digest to FRIDAY_ENQUIRY_EMAIL:
FRIDAY_GUIDE_DIGEST=
# Bearer secret (32+ characters) for POST /api/cron/briefings, /api/cron/quote-digest and /api/cron/guide-feedback-digest, for hosts that scale to zero. Unset: those routes return 404.
FRIDAY_CRON_SECRET=
# Optional international WhatsApp number (country code + number, digits only or starting with +).
# When unset, the planner hides its WhatsApp designer link.
FRIDAY_WHATSAPP_NUMBER=

# --- Itinerary generation for the planner (POST /api/itineraries). Separate from the research settings above. ---
# local = the deterministic generator in assets/js/trip-generator.js; claude = Claude picks and orders places from the
# catalog (it is sent only ids, names, kinds and areas). Unset: claude when ANTHROPIC_API_KEY is set, otherwise local.
# Any claude failure falls back to local.
ITINERARY_PROVIDER=
# Model for itinerary generation (defaults to AI_MODEL, then claude-sonnet-5-5) and request timeout.
ITINERARY_MODEL=
ITINERARY_TIMEOUT_MS=30000
# House knowledge for the claude itinerary provider: SKILL.md and references/*.md in this folder are added to its system prompt
# (read once at startup). Default server/knowledge/kusum, relative to the repo root. A missing folder is fine.
KNOWLEDGE_DIR=
# Set to off to disable.
KNOWLEDGE=
# Size cap in characters (default 60000).
KNOWLEDGE_MAX_CHARS=
# Comma list of SKILL.md "## " sections to keep. Default: Procedure, Pitfalls, Sightseeing specificity,
# Indian traveler knowledge, Sample evidence
KNOWLEDGE_SECTIONS=

# --- Optional trip data storage. The project ID/server key also power Hexclave auth and email when TRIP_STORAGE=sqlite. ---
# See README "Trip storage in Hexclave" before switching existing trips to a Data Vault.
# sqlite (default; trips stay in the application PostgreSQL database) or hexclave. With hexclave the server will not start unless the three values below are set.
TRIP_STORAGE=
# Hexclave dashboard -> Project Keys. The secret server key is server-only.
# Cloud project ID. The dev command supplies the local project's value automatically.
HEXCLAVE_PROJECT_ID=
# Server-only cloud key. The dev command supplies the local project's value automatically.
HEXCLAVE_SECRET_SERVER_KEY=
# Value-encryption secret you generate (openssl rand -base64 32). Keep a copy: without it stored trips cannot be read.
HEXCLAVE_VAULT_SECRET=
# Data Vault store name; create it in the dashboard first. Default friday-trips.
HEXCLAVE_VAULT_STORE=
# HEXCLAVE_API_URL=https://api.hexclave.com

# Set false (default while developing) for a no-login mode where auth is not enforced until the website is complete.
# When the website is complete, set true to enforce required sign-in. Production always requires sign-in regardless.
AUTH_REQUIRED=false
